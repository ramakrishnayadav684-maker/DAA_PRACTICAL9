def prim(graph, n):
    visited = [False] * n
    visited[0] = True 
    total_cost = 0

    for count in range(n - 1):
        minimum = float('inf')
        u = -1
        v = -1

        
        for i in range(n):
            if visited[i]:
                for j in range(n):
                    if graph[i][j] != 0 and not visited[j]:
                        if graph[i][j] < minimum:
                            minimum = graph[i][j]
                            u = i
                            v = j

     
        if v != -1:
            total_cost += minimum
            visited[v] = True

    print("Total Cost of Minimum Spanning Tree:", total_cost)

graph = [
    [0, 2, 0, 6, 0],
    [2, 0, 3, 8, 5],
    [0, 3, 0, 0, 7],
    [6, 8, 0, 0, 9],
    [0, 5, 7, 9, 0]
]

prim(graph, len(graph))
